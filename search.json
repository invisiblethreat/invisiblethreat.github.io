---
layout: none
---
[{% for post in site.posts %}{"title":{{ post.title | jsonify }},"text":{{ post.content | strip_html | normalize_whitespace | jsonify }},"tags":{{ post.tags | join: ' ' | jsonify }},"url":{{ post.url | relative_url | jsonify }},"date":{{ post.date | date: '%B %-d, %Y' | jsonify }}}{% unless forloop.last %},{% endunless %}{% endfor %}]
